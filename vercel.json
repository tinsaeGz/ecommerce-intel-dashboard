{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --workspace @suq-insights/web --workspace @suq-insights/shared-types --workspace @suq-insights/design-tokens --workspace @suq-insights/api-client --include-workspace-root",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "dev": true,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
